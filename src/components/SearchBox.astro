---
import XMark from "astro-heroicons/solid/XMark.astro";
---

<div id="search" style="display: none">
  <div
    class="fixed backdrop-blur w-screen h-screen z-[51] top-0 left-0 grid items-center p-2 sm:p-12"
  >
    <div
      class="absolute w-full h-full top-0 left-0 bg-gray-300 opacity-50 -z-[1]"
      id="searchBackdrop"
    >
    </div>
    <button class="z-10 w-12 h-12 absolute right-3 top-3" id="closeButton">
      <XMark />
    </button>
    <div
      class="relative max-w-xl mx-auto w-full shadow-xs bg-white px-4 sm:px-8 pb-10 pt-8 rounded-md overflow-visible"
    >
      <h3 class="text-xl mb-3">Search My Site</h3>

      <!-- Pagefind UI is mounted on first open so its ~75KB module is not
           on the critical path for every page view (PSI network tree). -->
      <div id="pagefindSearchRoot"></div>
    </div>
  </div>
</div>

<style>
  .is-open {
    display: block !important;
    z-index: 1000 !important;
  }
</style>

<script>
  import { sendEvent } from "../utils";
  import { debounce } from "../utils";

  let abortController: AbortController;
  let signal: AbortSignal;
  let searchIsOpen = false;
  let search: HTMLDivElement | null;
  let searchInput: HTMLInputElement | null;
  let searchBackdrop: HTMLDivElement | null;
  let closeButton: HTMLButtonElement | null;
  let searchUiReady: Promise<void> | null = null;

  function setVariables() {
    abortController = new AbortController();
    signal = abortController.signal;

    searchIsOpen = false;
    search = document.getElementById("search") as HTMLDivElement | null;
    searchInput = search?.querySelector(
      'input[type="text"]',
    ) as HTMLInputElement | null;
    searchBackdrop = document.getElementById(
      "searchBackdrop",
    ) as HTMLDivElement | null;
    closeButton = document.getElementById(
      "closeButton",
    ) as HTMLButtonElement | null;
  }

  const debouncedHandleSearch = debounce(function () {
    if (!searchInput?.value.length) {
      return;
    }

    sendEvent("search", {
      query: searchInput.value,
    });
  }, 500);

  /**
   * Lazy-load Pagefind from its generated static bundle (not the npm package
   * via Vite). Vite rewrites dynamic import() inside @pagefind/component-ui
   * and can break createInstance; the /pagefind/ assets use a plain import.
   * Idempotent after the first call.
   */
  function ensureSearchUi(): Promise<void> {
    if (searchUiReady) {
      return searchUiReady;
    }

    searchUiReady = (async () => {
      const root = document.getElementById("pagefindSearchRoot");
      if (!root) {
        return;
      }

      // Register custom elements first, then mount — avoids upgrade races.
      if (!document.querySelector('link[data-pagefind-ui-css]')) {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "/pagefind/pagefind-component-ui.css";
        link.dataset.pagefindUiCss = "";
        document.head.appendChild(link);
      }

      await import(/* @vite-ignore */ "/pagefind/pagefind-component-ui.js");

      if (!root.querySelector("pagefind-searchbox")) {
        const config = document.createElement("pagefind-config");
        config.setAttribute("bundle-path", "/pagefind/");
        root.appendChild(config);

        const box = document.createElement("pagefind-searchbox");
        box.setAttribute("autofocus", "");
        // Modal owns Cmd/Ctrl+K; hide Pagefind's own shortcut chrome.
        box.setAttribute("hide-shortcut", "");
        root.appendChild(box);
      }
    })();

    return searchUiReady;
  }

  function bindSearchInput() {
    searchInput = search?.querySelector(
      'input[type="text"]',
    ) as HTMLInputElement | null;

    if (searchInput) {
      searchInput.addEventListener("keyup", debouncedHandleSearch, { signal });
    }
  }

  async function showSearch() {
    await ensureSearchUi();
    bindSearchInput();

    if (!search) {
      return;
    }

    document.body.style.overflow = "hidden";
    search.classList.add("is-open");
    searchIsOpen = true;

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        searchInput?.focus();
      });
    });
  }

  function hideSearch() {
    document.body.style.overflow = "";
    search?.classList.remove("is-open");
    searchIsOpen = false;
  }

  function handleKeydown(event: KeyboardEvent) {
    if (event.key.toLowerCase() === "escape" && searchIsOpen) {
      event.preventDefault();
      hideSearch();
    }

    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      void showSearch();
      sendEvent("search_open", {
        method: "keyboard",
      });
    }
  }

  document.addEventListener("astro:before-preparation", () => {
    abortController?.abort();
  });

  document.addEventListener("astro:page-load", () => {
    setVariables();

    closeButton?.addEventListener("click", hideSearch, { signal });
    searchBackdrop?.addEventListener("click", hideSearch, { signal });
    bindSearchInput();
    document.addEventListener("keydown", handleKeydown, { signal });
    document.body.addEventListener(
      "search:open",
      () => {
        void showSearch();
      },
      { signal },
    );
  });
</script>
